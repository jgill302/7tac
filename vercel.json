{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck && npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/retry-emails/",
      "schedule": "0 12 * * *"
    }
  ]
}
